# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
APP_NAME=KasirKu API
# Separate multiple origins with commas when needed.
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false
REQUEST_BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pwl_pos
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_BASE64=

# JWT Authentication
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Rate Limiting
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Redis Cache
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TTL_SECONDS=300

# One-time production admin creation
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
